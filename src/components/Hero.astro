---
// Tagged so Miwa's analytics can tell arrivals from this site apart from the
// footer link and from direct traffic.
const miwaUrl = 'https://miwa.lol/?utm_source=tenshii.moe&utm_medium=referral&utm_campaign=hero';
---
<div class="relative flex items-center justify-center text-center gap-4 h-[80vh] px-4 max-md:flex-col lg:flex-col">
  <img
    src="/img/pfp.webp" alt="Avatar" class="mx-auto mb-3 size-38 md:size-48 rounded-full" draggable="false" width={192} height={192}
  />

  <div class="flex flex-col items-center max-w-2xl">
    <h1 class="text-4xl mb-5 font-bold">Hi! I'm Tenshii :)</h1>
    <p class="mb-5">A 19 yo developer from France 🇫🇷</p>

    <p>
      I'm building{' '}
      <a href={miwaUrl} target="_blank" class="inline-flex items-center gap-1.5 align-middle">
        {/* The link text already says the name, so the mark is decorative. */}
        <img
          src="https://miwa.lol/images/miwa-48.png" alt="" class="size-6"
          draggable="false" width={24} height={24}
        />
        <span>Miwa.lol</span>
      </a>, a modern and customizable link-in-bio website, which is a good alternative to Linktree and others!
    </p>
    <span class="text-sm mt-0.5 md:mt-1.5 text-gray-400">Trusted by more than 1,9k users, and still growing!</span>
  </div>
</div>
