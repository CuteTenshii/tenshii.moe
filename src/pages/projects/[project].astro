---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoryStyle, categories, projects, type Project } from '@/lib/projects';
import {
  SITE_ACCENT, actionRows, coverImage, escapeMarkdown, isEmbeddableMedia, linkButton, separator, text, thumbnail,
  type ComponentEmbed,
} from '@/lib/discord-embed';
import { firstImage } from '@/lib/content-image';

export const getStaticPaths: GetStaticPaths = () => projects.map((project) => ({
  params: { project: project.slug },
  props: { project },
}));

const { project } = Astro.props as { project: Project };
const entry = await getEntry('projects', project.slug);
const Content = entry ? (await render(entry)).Content : null;
const category = categories.find(({ id }) => id === project.category)!;
const description = project.description;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  description,
  applicationCategory: category.label,
  url: project.link,
};

const canonical = new URL(Astro.url.pathname, Astro.site);
const projectImage = project.image && new URL(project.image, Astro.site);
// Discord cannot unfurl SVG logos, so those fall back to the profile picture.
const embedThumbnail = projectImage && isEmbeddableMedia(projectImage)
  ? thumbnail(projectImage, `${project.name} logo`)
  : thumbnail(new URL('/img/pfp.webp', Astro.site), 'Tenshii');
const discordEmbed: ComponentEmbed = {
  component: {
    type: 17,
    accent_color: SITE_ACCENT,
    components: [
      {
        type: 9,
        components: [
          text(`## [${escapeMarkdown(project.name)}](${canonical})`),
          text(escapeMarkdown(description)),
          text(`-# ${escapeMarkdown(category.label)} · ${project.tech.map(({ name }) => escapeMarkdown(name)).join(', ')}`),
        ],
        accessory: embedThumbnail,
      },
      ...coverImage(entry ? await firstImage(entry) : null, Astro.site),
      separator(),
      ...actionRows([
        linkButton('View project', canonical),
        ...project.links.map(({ label, url }) => linkButton(label, url)),
      ]),
    ],
  },
};
---

<BaseLayout title={`${project.name} - Projects - Tenshii.moe`} description={description} structuredData={structuredData} discordEmbed={discordEmbed}>
  <div class="container mx-auto max-w-3xl px-4 py-8 pt-16">
    <a href="/projects/" class="inline-flex items-center gap-2 text-sm text-gray-400 transition-colors hover:text-white">
      <ArrowLeft size={15} /> All projects
    </a>

    <article class="mt-6">
      <header class="mb-8 border-b border-gray-700/70 pb-6">
        <div class="flex items-start justify-between gap-5">
          <div class="min-w-0">
            <div class="mb-3">
              <span class={`rounded-full px-3 py-1 text-xs font-medium ${categoryStyle[project.category]}`}>{category.label}</span>
            </div>
            <h1 class="mb-3 text-3xl font-bold sm:text-4xl">{project.name}</h1>
            <p class="text-gray-300">{description}</p>

            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
              {project.links.map(({ label, url, Icon, tint }) => {
                return (
                  <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-blue-400 underline underline-offset-4 transition-colors hover:text-blue-300">
                    <span class={tint}>
                      <Icon size={15} />
                    </span>
                    {label}
                  </a>
                );
              })}
            </div>
          </div>
          {project.image && (
            <img src={project.image} alt={`${project.name} logo`} class="h-16 w-16 shrink-0 rounded-xl object-cover sm:h-20 sm:w-20" />
          )}
        </div>
      </header>

      {Content && (
        <div class="article-body mb-8">
          <Content />
        </div>
      )}

      <section aria-labelledby="built-with">
        <h2 id="built-with" class="mb-4 text-xl font-bold">Built with</h2>
        <ul class="flex flex-wrap gap-2">
          {project.tech.map(({ name, Icon }) => (
            <li class="inline-flex items-center gap-2 rounded-md bg-gray-800/70 px-3 py-2 text-sm text-gray-300">
              <Icon size={15} /><span>{name}</span>
            </li>
          ))}
        </ul>
      </section>
    </article>

  </div>
</BaseLayout>
