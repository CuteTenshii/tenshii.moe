---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, readingTimeMinutes, formatPostDate } from '@/lib/blog';
import Rss from '@lucide/astro/icons/rss';

const posts = await getPosts();

const canonical = new URL(Astro.url.pathname, Astro.site);
const author = { '@type': 'Person', name: 'Tenshii', url: 'https://tenshii.moe' };
const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Tenshii\'s blog',
  url: canonical.toString(),
  author,
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
    author,
  })),
};
---
<BaseLayout
  title="Blog - Tenshii.moe"
  description="Notes on the things I build and take apart: Go, Rust, reverse engineering, and whatever else I got stuck on."
  structuredData={blogJsonLd}
>
  <div class="container mx-auto max-w-3xl px-4 py-8 pt-16">
    <h1 class="text-3xl font-bold mb-3">Blog</h1>
    <p class="text-gray-300">
      Notes on the things I build and take apart. Mostly Go and Rust, often reverse engineering,
      usually whatever I got stuck on that week.
    </p>

    {posts.length > 0 && (
      <ul class="mt-8 border-t border-gray-700/70">
        {posts.map((post) => (
          <li class="border-b border-gray-700/70">
            <a
              href={`/blog/${post.id}/`}
              class="group -mx-3 block rounded-lg px-3 py-5 transition-colors hover:bg-gray-800/60"
            >
              <h2 class="text-lg font-semibold font-lato mb-1.5 group-hover:text-blue-300 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-400 text-sm leading-relaxed mb-2">{post.data.description}</p>
              <p class="text-xs text-gray-400">
                <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
                <span class="px-1.5" aria-hidden="true">/</span>
                {readingTimeMinutes(post.body)} min read
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-6 text-sm">
      <a href="/rss.xml" class="inline-flex items-center gap-1.5 text-blue-400 underline underline-offset-4 transition-colors hover:text-blue-300">
        <Rss size={14} />
        Follow along by RSS
      </a>
    </p>
  </div>
</BaseLayout>
