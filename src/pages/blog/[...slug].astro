---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, readingTimeMinutes, formatPostDate, wordCount, type BlogPost } from '@/lib/blog';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import {
  SITE_ACCENT, coverImage, escapeMarkdown, linkButton, separator, text, thumbnail, type ComponentEmbed,
} from '@/lib/discord-embed';
import { firstImage } from '@/lib/content-image';
import { breadcrumbs, graph, personRef, siteUrl } from '@/lib/structured-data';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;

const canonical = siteUrl(Astro.url.pathname);
const cover = await firstImage(post);
const structuredData = graph(
  {
    '@type': 'BlogPosting',
    headline: title,
    description,
    // Google recommends an image on every article, so posts without one fall back to the avatar.
    image: siteUrl(cover?.src ?? '/img/pfp.webp'),
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: personRef(),
    publisher: personRef(),
    url: canonical,
    mainEntityOfPage: canonical,
    inLanguage: 'en',
    wordCount: wordCount(post.body),
  },
  breadcrumbs(['Blog', '/blog/'], [title, Astro.url.pathname]),
);

const published = `<t:${Math.floor(pubDate.getTime() / 1000)}:D>`;
const updated = updatedDate ? ` · updated <t:${Math.floor(updatedDate.getTime() / 1000)}:D>` : '';
const discordEmbed: ComponentEmbed = {
  component: {
    type: 17,
    accent_color: SITE_ACCENT,
    components: [
      {
        type: 9,
        components: [
          text(`## [${escapeMarkdown(title)}](${canonical})`),
          text(escapeMarkdown(description)),
          text(`-# ${published} · ${readingTimeMinutes(post.body)} min read${updated}`),
        ],
        accessory: thumbnail(new URL('/img/pfp.webp', Astro.site), 'Tenshii'),
      },
      ...coverImage(cover, Astro.site),
      separator(),
      { type: 1, components: [linkButton('Read post', canonical)] },
    ],
  },
};
---
<BaseLayout
  title={`${title} - Tenshii.moe`}
  description={description}
  ogType="article"
  publishedDate={pubDate}
  modifiedDate={updatedDate}
  structuredData={structuredData}
  discordEmbed={discordEmbed}
>
  <div class="container mx-auto max-w-3xl px-4 py-8 pt-16">
    <article>
      <header class="mb-8 border-b border-gray-700/70 pb-6">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3">{title}</h1>
        <p class="text-gray-300 mb-4">{description}</p>
        <p class="text-sm text-gray-400">
          <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
          <span class="px-1.5" aria-hidden="true">/</span>
          {readingTimeMinutes(post.body)} min read
          {updatedDate && (
            <>
              <span class="px-1.5" aria-hidden="true">/</span>
              updated <time datetime={updatedDate.toISOString()}>{formatPostDate(updatedDate)}</time>
            </>
          )}
        </p>
      </header>

      <div class="article-body">
        <Content />
      </div>

      <footer class="mt-10 border-t border-gray-700/70 pt-6 text-sm">
        <a
          href="/blog/"
          class="inline-flex items-center gap-1.5 text-blue-400 underline underline-offset-4 transition-colors hover:text-blue-300"
        >
          <ArrowLeft size={14} />
          All posts
        </a>
      </footer>
    </article>
  </div>
</BaseLayout>
