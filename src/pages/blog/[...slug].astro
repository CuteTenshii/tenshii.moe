---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, readingTimeMinutes, formatPostDate, type BlogPost } from '@/lib/blog';
import ArrowLeft from '@lucide/astro/icons/arrow-left';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;

const canonical = new URL(Astro.url.pathname, Astro.site);
const author = {
  '@type': 'Person',
  name: 'Tenshii',
  url: 'https://tenshii.moe',
  sameAs: ['https://github.com/CuteTenshii', 'https://twitter.com/10shii7'],
};
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author,
  publisher: { '@type': 'Person', name: 'Tenshii', url: 'https://tenshii.moe' },
  url: canonical.toString(),
  mainEntityOfPage: canonical.toString(),
};
---
<BaseLayout
  title={`${title} - Tenshii.moe`}
  description={description}
  ogType="article"
  publishedDate={pubDate}
  modifiedDate={updatedDate}
  structuredData={blogPosting}
>
  <div class="container mx-auto max-w-3xl px-4 py-8 pt-16">
    <article>
      <header class="mb-8 border-b border-gray-700/70 pb-6">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3">{title}</h1>
        <p class="text-gray-300 mb-4">{description}</p>
        <p class="text-sm text-gray-400">
          <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
          <span class="px-1.5" aria-hidden="true">/</span>
          {readingTimeMinutes(post.body)} min read
          {updatedDate && (
            <>
              <span class="px-1.5" aria-hidden="true">/</span>
              updated <time datetime={updatedDate.toISOString()}>{formatPostDate(updatedDate)}</time>
            </>
          )}
        </p>
      </header>

      <div class="article-body">
        <Content />
      </div>

      <footer class="mt-10 border-t border-gray-700/70 pt-6 text-sm">
        <a
          href="/blog/"
          class="inline-flex items-center gap-1.5 text-blue-400 underline underline-offset-4 transition-colors hover:text-blue-300"
        >
          <ArrowLeft size={14} />
          All posts
        </a>
      </footer>
    </article>
  </div>
</BaseLayout>
